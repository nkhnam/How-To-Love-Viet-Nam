# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

HOST=0.0.0.0
PORT=5000

# Optional: comma-separated origins, or * for any
CORS_ORIGINS=*

# Optional: shared secret enforced via the X-Api-Token header on POST routes
API_TOKEN=

# Optional: chat history persistence (Realtime Database REST API)
FIREBASE_DB_URL=
FIREBASE_API_KEY=

# Optional overrides (defaults point to <repo>/data)
# DATA_DIR=
# FAISS_DIR=
# KNOWLEDGE_DIR=
